<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_FILE"
              value="${MAIL_MCP_LOG_FILE:-${user.home}/.opcoach-mcp-mail/logs/opcoach-mcp-mail.log}"/>
    <property name="LOG_LEVEL" value="${MAIL_MCP_LOG_LEVEL:-INFO}"/>

    <appender name="MCP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <append>true</append>
        <encoder>
            <pattern>%date{ISO8601} %-5level [%thread] %logger{40} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>10</maxHistory>
            <totalSizeCap>450MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <root level="${LOG_LEVEL}">
        <appender-ref ref="MCP_FILE"/>
    </root>
</configuration>
